# ---------- Microsoft 365 / Outlook (OAuth 2.0 — الأولوية) ----------
# من Azure Portal > App registrations > التطبيق > Overview
MICROSOFT_CLIENT_ID=
# من Certificates & secrets > Client secrets
MICROSOFT_CLIENT_SECRET=
# معرّف الدليل (Directory/tenant ID). استخدم "common" للسماح بأي حساب Microsoft.
MICROSOFT_TENANT_ID=common
# يجب أن يطابق Redirect URI المُسجَّل في Azure بالضبط (نوع Web):
#   https://<your-domain>/api/email-accounts/microsoft/callback
MICROSOFT_REDIRECT_URI=

# ---------- Google / Gmail (المرحلة الثانية — نفس البنية) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#   https://<your-domain>/api/email-accounts/google/callback
GOOGLE_REDIRECT_URI=

# ---------- تشفير رموز OAuth قبل تخزينها في قاعدة البيانات ----------
# مفتاح AES-256 بطول 32 بايت مُرمَّز base64. أنشئه بـ: openssl rand -base64 32
ENCRYPTION_KEY=
